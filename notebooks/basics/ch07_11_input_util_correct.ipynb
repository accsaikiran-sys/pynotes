      "source": [
        "while True:\n",
        "    try:\n",
        "        number = int(input(\"Enter a number: \"))\n",
        "        print(f\"Success! You entered: {number}\")\n",
        "        break\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Invalid input! Please enter a valid integer.\")"
      ]
    }

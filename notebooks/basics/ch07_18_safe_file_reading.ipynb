      "source": [
        "try:\n",
        "    user_input = input(\"Enter file name: \")\n",
        "    file = open(user_input, \"r\")\n",
        "    content = file.read()\n",
        "    print(content)\n",
        "except FileNotFoundError:\n",
        "    print(\"Unable to read file .\")"
      ]
    }

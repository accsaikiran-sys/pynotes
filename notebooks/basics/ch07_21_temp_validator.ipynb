      "source": [
        "try:\n",
        "    user_input = int(input(\"Enter temperature: \"))\n",
        "    if user_input < -273:\n",
        "        raise ValueError(\"Temperature below absolute zero\")\n",
        "except ValueError as e:\n",
        "    print(\"Invalid temperature value\")"
      ]
    }

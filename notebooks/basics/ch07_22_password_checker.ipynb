      "source": [
        "try:\n",
        "    password = input(\"Enter password: \")\n",
        "    if len(password) < 6:\n",
        "        raise ValueError(\"Password too short\")\n",
        "    else:\n",
        "        print(\"Password is valid\")\n",
        "except ValueError as e:\n",
        "    print(e)"
      ]
    }

      "source": [
        "values = [5, \"hello\", 7, \"world\", 3]\n",
        "for value in values:\n",
        "    try:\n",
        "        result = int(value)\n",
        "        print(result)\n",
        "    except ValueError:\n",
        "        print(\"Skipping non-number\")"
      ]
    }

      "source": [
        "try:\n",
        "    num1 = float(input(\"enter first number: \"))\n",
        "    num2 = float(input(\"enter second number: \"))\n",
        "\n",
        "    print(\"Result: \", num1 / num2)\n",
        "\n",
        "except ZeroDivisionError:\n",
        "    print(\"Cannot divide by zero!\")"
      ]

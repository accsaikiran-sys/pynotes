        "# Ch07 24 Simple Age Group Checker"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "try:\n",
        "    age = int(input (\"Enter age: \"))\n",
        "    if age <13:\n",
        "        print (\"Child\")\n",
        "    elif age <18:\n",
        "        print (\"Teenager\")\n",
        "    else:\n",
        "        print (\"Adult\")\n",
        "except ValueError :\n",
        "    print (\"Invalid age\")"
      ]
    }
